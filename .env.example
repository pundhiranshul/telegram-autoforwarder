# ==========================================
# Telegram API Credentials
# (Obtain from https://my.telegram.org)
# ==========================================
API_ID=12345678
API_HASH=your_api_hash_here

# ==========================================
# Telegram Bot Configuration
# (Obtain from @BotFather on Telegram)
# ==========================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ==========================================
# Administration & Crash Reporting
# ==========================================
# The Channel/Group ID where crash dumps & error logs will be sent (starts with -100)
BUG_CHANNEL_ID=-1001234567890

# Comma-separated Telegram User IDs for system administrators
SUPERUSERS=123456789,987654321
